{#- The 800x480 weather screen. Rendered with a `DisplayView` named `view`. -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="stylesheet" href="{{ view.static_base }}/style.css" />
</head>
<body>
  <div class="screen">
    {%- set h = view.header %}
    {%- set icons = view.static_base ~ "/icons" %}

    <header class="topbar">
      <span class="updated">Updated {{ view.updated }}</span>
      <span class="battery">
        {%- set fill = (view.battery_pct / 100 * 30) %}
        {%- set colour = "var(--warn)" if view.battery_low else "var(--ok)" %}
        <svg width="40" height="20" viewBox="0 0 40 20" aria-label="battery">
          <rect x="1" y="3" width="34" height="14" rx="2" fill="none" stroke="var(--ink)" stroke-width="2" />
          <rect x="36" y="7" width="3" height="6" fill="var(--ink)" />
          <rect x="3" y="5" width="{{ fill }}" height="10" fill="{{ colour }}" />
        </svg>
      </span>
    </header>

    <section class="current">
      <div class="now">
        <img class="cond-icon" src="{{ icons }}/{{ h.condition_icon }}.svg" alt="{{ h.condition_label }}" />
        <div class="temp">
          <span class="temp-primary">{{ h.temp_primary }}&deg;<span class="unit">{{ h.unit_primary }}</span></span>
          <span class="temp-secondary">{{ h.temp_secondary }}</span>
          <span class="cond-label">{{ h.condition_label }}</span>
        </div>
      </div>

      <div class="stats">
        <div class="stat">
          <img src="{{ icons }}/humidity.svg" alt="" />
          <div class="pair">
            <span class="value">{{ h.humidity }}%</span>
            <span class="label">Humidity</span>
          </div>
        </div>
        <div class="stat">
          <img src="{{ icons }}/uv.svg" alt="" />
          <div class="pair">
            <span class="value">{{ h.uv_index }}</span>
            <span class="label">UV &middot; {{ h.uv_label }}</span>
          </div>
        </div>
        <div class="stat">
          <img src="{{ icons }}/sunrise.svg" alt="" />
          <div class="pair">
            <span class="value">{{ h.sunrise }}</span>
            <span class="label">Sunrise</span>
          </div>
        </div>
        <div class="stat">
          <img src="{{ icons }}/sunset.svg" alt="" />
          <div class="pair">
            <span class="value">{{ h.sunset }}</span>
            <span class="label">Sunset</span>
          </div>
        </div>
      </div>
    </section>

    <section class="chart">
      <div class="chart-title">
        Next {{ view.chart.bars | length }} hours &middot; temperature and
        precipitation chance
      </div>
      <svg viewBox="0 0 {{ view.chart.width }} {{ view.chart.height }}" preserveAspectRatio="none">
        {% for bar in view.chart.bars %}
        <rect class="precip-bar" x="{{ '%.1f' % bar.precip_x }}" y="{{ '%.1f' % bar.precip_y }}" width="{{ '%.1f' % bar.precip_w }}" height="{{ '%.1f' % bar.precip_h }}" rx="1.5" />
        {% endfor %}
        <polyline class="temp-line" points="{{ view.chart.temp_points }}" />
        {% for bar in view.chart.bars %}
        <circle class="temp-dot" cx="{{ '%.1f' % bar.temp_x }}" cy="{{ '%.1f' % bar.temp_y }}" r="2.5" />
        {% if bar.show_temp %}
        <text class="temp-val" x="{{ '%.1f' % bar.temp_x }}" y="{{ '%.1f' % (bar.temp_y - 8) }}">{{ bar.temp_label }}</text>
        {% endif %}
        {% if bar.show_hour %}
        <text class="hour" x="{{ '%.1f' % bar.x }}" y="{{ '%.1f' % (view.chart.height - 2) }}">{{ bar.hour_label }}</text>
        {% endif %}
        {% endfor %}
      </svg>
    </section>

    <section class="chips">
      {% for chip in view.chips %}
      <div class="chip">
        <div class="chip-day">{{ chip.label }}</div>
        <img class="chip-icon" src="{{ icons }}/{{ chip.icon }}.svg" alt="" />
        <div class="chip-temps">
          <span class="hi">{{ chip.high }}</span>
          <span class="lo">{{ chip.low }}</span>
        </div>
        <div class="chip-precip">
          <img src="{{ icons }}/droplet.svg" alt="" />{{ chip.precip_pct }}%
        </div>
      </div>
      {% endfor %}
    </section>
  </div>
</body>
</html>
