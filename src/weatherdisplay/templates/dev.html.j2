{#- Dev-mode preview page: live HTML on top, simulated e-ink image below. -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>WeatherDisplay - dev preview</title>
  <style>
    body {
      font-family: system-ui, "Segoe UI", Arial, sans-serif;
      margin: 0;
      background: #2b2b2b;
      color: #ddd;
    }

    header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 12px 20px;
      background: #1c1c1c;
      border-bottom: 1px solid #000;
    }

    header h1 {
      font-size: 18px;
      margin: 0;
      font-weight: 600;
    }

    header .meta {
      font-size: 13px;
      color: #999;
    }

    header form {
      margin-left: auto;
    }

    button,
    .pill {
      font: inherit;
      font-size: 13px;
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid #444;
      background: #333;
      color: #eee;
      cursor: pointer;
    }

    main {
      display: flex;
      flex-wrap: wrap;
      gap: 28px;
      padding: 24px;
      align-items: flex-start;
    }

    .pane h2 {
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #999;
      margin: 0 0 8px;
    }

    .frame {
      width: 800px;
      height: 480px;
      border: 1px solid #000;
      background: #fff;
    }

    .eink {
      width: 800px;
      height: 480px;
      image-rendering: pixelated;
      border: 1px solid #000;
    }

    .note {
      max-width: 800px;
      font-size: 13px;
      line-height: 1.5;
      color: #aaa;
    }
  </style>
</head>
<body>
  <header>
    <h1>WeatherDisplay</h1>
    <span class="meta">
      {{ location }} &middot; updated {{ fetched }} &middot;
      saturation {{ saturation }} &middot; battery {{ battery_pct }}%
    </span>
    <form action="{{ refetch_url }}" method="post">
      <button type="submit">Re-fetch weather</button>
    </form>
  </header>

  <main>
    <section class="pane">
      <h2>Live HTML (800&times;480)</h2>
      <iframe class="frame" src="{{ screen_url }}" title="live"></iframe>
    </section>

    <section class="pane">
      <h2>Simulated e-ink &middot; 6-colour dither (800&times;480)</h2>
      <img class="eink" src="{{ image_url }}" alt="e-ink simulation" />
      <p class="note">
        This is the faithful Spectra-6 output at 1:1 panel resolution: the
        same Floyd-Steinberg dithering the panel applies, at the configured
        saturation. Edit a template or the stylesheet and this page reloads
        automatically.
      </p>
    </section>
  </main>
</body>
</html>
