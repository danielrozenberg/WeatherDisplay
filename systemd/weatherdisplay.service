# WeatherDisplay update service.
#
# This is a template: install.sh substitutes the @TOKENS@ with absolute paths
# and installs the result to /etc/systemd/system/weatherdisplay.service.
#
# The PiSugar RTC powers the Pi on; systemd then runs this oneshot job once per
# boot. The job fetches the weather, updates the panel, schedules the next
# wake-up and powers the Pi off again. Logs go to the journal:
#   journalctl -u weatherdisplay

[Unit]
Description=WeatherDisplay e-ink weather update
# time-sync.target is only reached once the clock is NTP-synced (install.sh
# enables systemd-time-wait-sync, with a bounded timeout).
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=root
WorkingDirectory=@INSTALL_DIR@
Environment=WEATHERDISPLAY_STATE=@STATE_DIR@
ExecStart=@VENV@/bin/weatherdisplay --config @CONFIG@ update
# Covers the worst-case error path: with fetch_retries=4, a timing-out network
# takes up to ~475s of fetch attempts and backoff before the error banner.
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
